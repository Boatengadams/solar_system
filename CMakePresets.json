{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 16, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Developer Debug (host)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "BAGS_LAB_PORTABLE": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Developer Release (host)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "BAGS_LAB_PORTABLE": "OFF"
      }
    },
    {
      "name": "portable",
      "displayName": "Portable (host defaults → usually linux-x64)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-portable",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "BAGS_LAB_INSTALL_PLANET_MODELS": "ON",
        "BAGS_LAB_BUNDLE_RAYLIB": "ON",
        "BAGS_LAB_PORTABLE": "ON"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 portable (native Linux x86_64 host)",
      "inherits": "portable",
      "binaryDir": "${sourceDir}/build-linux-x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-arm64",
      "displayName": "Linux ARM64 (requires aarch64 toolchain or native ARM host)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-linux-arm64",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-arm64.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "BAGS_LAB_INSTALL_PLANET_MODELS": "ON",
        "BAGS_LAB_BUNDLE_RAYLIB": "ON",
        "BAGS_LAB_PORTABLE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (native Windows host — MSVC recommended)",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON",
        "BAGS_LAB_INSTALL_PLANET_MODELS": "ON",
        "BAGS_LAB_BUNDLE_RAYLIB": "ON",
        "BAGS_LAB_PORTABLE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-x64-mingw-cross",
      "displayName": "Windows x64 MinGW cross (Linux host — NOT VERIFIED runtime)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-windows-x64-mingw",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-x64-mingw.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "BAGS_LAB_INSTALL_PLANET_MODELS": "ON",
        "BAGS_LAB_BUNDLE_RAYLIB": "ON",
        "BAGS_LAB_PORTABLE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS x64 (native macOS host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64",
        "BUILD_TESTING": "ON",
        "BAGS_LAB_INSTALL_PLANET_MODELS": "ON",
        "BAGS_LAB_BUNDLE_RAYLIB": "ON",
        "BAGS_LAB_PORTABLE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS ARM64 (native macOS host)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BUILD_TESTING": "ON",
        "BAGS_LAB_INSTALL_PLANET_MODELS": "ON",
        "BAGS_LAB_BUNDLE_RAYLIB": "ON",
        "BAGS_LAB_PORTABLE": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "jobs": 2 },
    { "name": "release", "configurePreset": "release", "jobs": 2 },
    { "name": "portable", "configurePreset": "portable", "jobs": 2 },
    { "name": "linux-x64", "configurePreset": "linux-x64", "jobs": 2 },
    { "name": "linux-arm64", "configurePreset": "linux-arm64", "jobs": 2 },
    { "name": "windows-x64", "configurePreset": "windows-x64", "jobs": 2 },
    { "name": "windows-x64-mingw-cross", "configurePreset": "windows-x64-mingw-cross", "jobs": 2 },
    { "name": "macos-x64", "configurePreset": "macos-x64", "jobs": 2 },
    { "name": "macos-arm64", "configurePreset": "macos-arm64", "jobs": 2 }
  ],
  "testPresets": [
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "portable", "configurePreset": "portable", "output": { "outputOnFailure": true } },
    { "name": "linux-x64", "configurePreset": "linux-x64", "output": { "outputOnFailure": true } }
  ],
  "packagePresets": [
    {
      "name": "linux-x64",
      "configurePreset": "linux-x64",
      "generators": ["TGZ"]
    }
  ]
}

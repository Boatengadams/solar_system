*.bc
*.bpc
*spice-manifest*.json

# Generated portable runtime packages stay on the USB filesystem but are not
# committed (~hundreds of MB of binaries/libs/assets copies). Keep README stubs.
/dist/**
!/dist/README.md
!/dist/*/
!/dist/*/README.md

# Keep documentation and source assets trackable (never ignore these trees).
!/README.md
!/LICENSE
!/CHANGELOG.md
!/CONTRIBUTING.md
!/PROJECT.md
!/ARCHITECTURE.md
!/ROADMAP.md
!/docs/
!/docs/**
!/assets/
!/assets/**
!/data/
!/data/**
!/launcher/
!/launcher/**
!/platform/
!/platform/**
!/cmake/
!/cmake/**
!/tools/
!/tools/**
